# Content Engine secrets. Copy to `.env` and fill in. `.env` is gitignored.
# The engine loads these via dotenv at run time; --dry-run needs NONE of them.

# Higgsfield — official SDK is @higgsfield/client (repo: higgsfield-ai/higgsfield-js).
# Confirm exact auth fields against node_modules/@higgsfield/client types before real calls.
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=

# Anthropic — Claude Sonnet for compile, copy, and vision scoring.
ANTHROPIC_API_KEY=

# ElevenLabs — voiceover.
ELEVENLABS_API_KEY=
