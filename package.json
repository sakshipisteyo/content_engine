{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root packages/engine",
    "test:watch": "vitest --root packages/engine",
    "engine": "tsx scripts/run.ts",
    "report": "tsx scripts/report.ts",
    "review": "pnpm --filter review dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
